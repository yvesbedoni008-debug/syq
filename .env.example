# Environment variables for SYQ Application
# Copy this file to .env and modify as needed

# Application Settings
PROJECT_NAME=SYQ - Opportunity Intelligence Platform
VERSION=0.1.0
API_V1_STR=/api/v1
ENVIRONMENT=development

# Security Settings
SECRET_KEY=your-super-secret-key-change-this-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_HOSTS=*

# Database Settings
# Local development (default): SQLite via aiosqlite
DATABASE_URL=sqlite+aiosqlite:///./syq.db

# Production on Render: set DATABASE_URL to the Internal Database URL from Render
# Example: postgres://user:pass@host:5432/syqdb

# Optional: individual Postgres settings for local Postgres instead of SQLite
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syq
POSTGRES_PORT=5432

# Redis Settings (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# CORS Settings (JSON array or comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Logging
LOG_LEVEL=INFO
